<script src="{{ ASSETS_URL }}/htmx-static/htmx.min.js"></script>
<script src="https://unpkg.com/htmx.org@1.9.12/dist/ext/json-enc.js"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0">
<link rel="stylesheet" href="{{ ASSETS_URL }}/static/stamp.css"> 
<link rel="stylesheet" href="{{ ASSETS_URL }}/static/main.css"> 
<!--script type="module" src="{{ ASSETS_URL }}/static/stamp.js"></script-->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<div id='' class="tw-preflight">
    <div "stamp-container" class="dark:tw-bg-[#1e1e1e] tw-bg-white tw-p-4">
        <button id="toggle-theme-stamp" class="tw-hidden"></button>
        <div id="stamp-app" class="">
            {% include "stamps_card.html.jinja" %}
        </div>
        
    </div>
</div>
<script>
    if (typeof STAMP_CONFIG === 'undefined') {
        var STAMP_CONFIG = {
            oid: "{{oid}}",
            survey_id: "{{ survey_id }}",
            detections_list: {{ detections | tojson | safe }} 
        };
    } else {
        STAMP_CONFIG.oid = "{{oid}}";
        STAMP_CONFIG.survey_id = "{{ survey_id }}";
        STAMP_CONFIG.detections_list = {{ detections | tojson | safe }};
    }

    // The body of an update_stamp_card request, sent by the card's controls through hx-vals. Not an htmx extension:
    // in the explorer every htmx card loads its own copy of htmx, each replacing window.htmx, so an extension
    // registered here could land on a different instance than the one handling the card (a 422 without a body).
    // Takes the control's id: what `this` is in an hx-vals expression differs between htmx versions.
    window.stampPayload = function (controlId) {
        const elt = document.getElementById(controlId);
        // The N↑ button carries the orientation it switches to, and shows the current one
        const northUpButton = document.getElementById('northUpStamps');
        let northUp = true;
        if (elt.hasAttribute('data-north-up')) {
            northUp = elt.getAttribute('data-north-up') === 'true';
        } else if (northUpButton) {
            northUp = northUpButton.getAttribute('aria-pressed') === 'true';
        }

        return JSON.stringify({
            oid: STAMP_CONFIG.oid,
            survey_id: STAMP_CONFIG.survey_id,
            measurement_id: elt.tagName === 'SELECT' ? elt.value : elt.getAttribute('data-measurement-id'),
            detections_list: STAMP_CONFIG.detections_list,
            north_up: northUp
        });
    };
</script>
