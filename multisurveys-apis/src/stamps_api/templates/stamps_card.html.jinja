<div class="tw-flex tw-flex-wrap tw-justify-between tw-items-center tw-gap-2 tw-mb-2">
    <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-x-3 tw-gap-y-2">
        <h1 class="tw-font-semibold tw-text-2xl tw-m-0 dark:tw-text-white tw-text-black">Stamps</h1>
        <div class="tw-flex tw-justify-start tw-items-center tw-gap-1">

            <div class="tw-whitespace-nowrap">
                <div class="tw-inline-block tw-cursor-pointer tw-w-[60%]">
                    <button id="mid_arrow" class="tw-relative tw-cursor-pointer">
                        <select 
                            id="measurement_id" 
                            aria-label="Date"
                            name="measurement_id" 
                            class="tw-appearance-none tw-cursor-pointer tw-border tw-border-gray-300 dark:tw-border-gray-600 tw-rounded tw-pl-3 tw-pr-10 tw-py-2 tw-bg-white dark:hover:tw-bg-gray-800 dark:tw-bg-[#1e1e1e] dark:hover:tw-bg-gray-800 tw-cursor-pointer tw-text-black dark:tw-text-white tw-text-base"
                            hx-post="{{ API_URL }}/htmx/update_stamp_card"
                            hx-trigger="change"
                            hx-target="#stamp-app"
                            hx-swap="innerHTML"
                            hx-vals="js:{payload: stampPayload('measurement_id')}"
                        >
                            {% for detection in detections %}
                                <option class="tw-cursor-pointer" value="{{detection.measurement_id}}" 
                                    {% if detection.measurement_id|string == selected_measurement_id|string %}
                                        selected
                                    {% endif %}
                                >{{detection.greg}} ({{detection.band}}-band) {% if not detection.has_stamp %} (no stamps) {% endif %}</option>
                            {% endfor %}
                        </select>

                        <div id="mjd_arrow" class="tw-pointer-events-none tw-absolute tw-inset-y-0 tw-right-0 tw-flex tw-items-center tw-px-2">
                            <svg name="arrow_icon" data-direction="down" class="tw-w-[24px] tw-h-[24px] tw-fill-current tw-text-black dark:tw-text-white" viewBox="0 -960 960 960">
                                <path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/>
                            </svg>
                        </div>
                    </button>
                </div> 
            </div>

            <div class="tw-flex tw-gap-1">
                <button id="prevDate" 
                    data-measurement-id="{{ prv_measurement_id }}"
                    class="tw-inline-flex tw-justify-center tw-items-center tw-w-[24px] tw-h-[24px] tw-rounded tw-transition-all tw-duration-200 tw-border
                    {% if prv_measurement_id == selected_measurement_id %}
                        tw-bg-gray-100 dark:tw-bg-gray-800 tw-text-gray-400 dark:tw-text-gray-600 tw-cursor-not-allowed tw-border-gray-200 dark:tw-border-gray-600
                    {% else %}
                        tw-bg-white dark:tw-bg-[#1e1e1e] tw-text-black dark:tw-text-white tw-cursor-pointer hover:tw-bg-gray-100 dark:hover:tw-bg-gray-800 tw-border-gray-700 dark:tw-border-gray-300
                    {% endif %}"
                    {% if prv_measurement_id != selected_measurement_id %}
                        hx-post="{{ API_URL }}/htmx/update_stamp_card"
                        hx-trigger="click"
                        hx-target="#stamp-app"
                        hx-swap="innerHTML"
                        hx-vals="js:{payload: stampPayload('prevDate')}"
                    {% else %}
                        disabled
                    {% endif %}
                    title="Previous date">
                ←
                </button>

                <button id="nextDate" 
                    data-measurement-id="{{ nxt_measurement_id }}"
                    class="tw-inline-flex tw-justify-center tw-items-center  tw-w-[24px] tw-h-[24px] tw-rounded tw-transition-all tw-duration-200 tw-border
                    {% if nxt_measurement_id == selected_measurement_id %}
                        tw-bg-gray-100 dark:tw-bg-gray-800 tw-text-gray-400 dark:tw-text-gray-600 tw-cursor-not-allowed tw-border-gray-200 dark:tw-border-gray-600
                    {% else %}
                        tw-bg-white dark:tw-bg-[#1e1e1e] tw-text-black dark:tw-text-white tw-cursor-pointer hover:tw-bg-gray-100 dark:hover:tw-bg-gray-800 tw-border-gray-700 dark:tw-border-gray-300
                    {% endif %}"
                    {% if nxt_measurement_id != selected_measurement_id %}
                        hx-post="{{ API_URL }}/htmx/update_stamp_card"
                        hx-trigger="click"
                        hx-target="#stamp-app"
                        hx-swap="innerHTML"
                        hx-vals="js:{payload: stampPayload('nextDate')}"
                    {% else %}
                        disabled
                    {% endif %}
                    title="Next date">
                →
                </button>
            </div>
    
            {% if survey_id == "ztf" %}
            {% include "avro/avro_popup.html.jinja" %}
            <button
             id="avro-btn-modal"
             command="show-modal"
             commandfor="avro-dialog"
             class="tw-inline-flex tw-justify-center tw-items-center tw-w-[61px] tw-h-[28px] tw-p-2 tw-bg-blue-600 hover:tw-bg-blue-700 tw-text-white tw-rounded tw-font-medium tw-transition-colors"
             hx-get="{{ API_URL }}/htmx/avro"
             hx-vals='{"oid": "{{oid}}", "measurement_id": "{{selected_measurement_id}}", "survey_id": "{{survey_id}}"}'
             hx-trigger="click"
             hx-target="#avro-modal"
             title="AVRO is the format in which we receive alerts from ZTF. Click to show the full information contained in the avro file for the selected detection."
             >
                <span>AVRO</span>
            </button>
            {% endif %}
        </div>
    </div>
    <div class="stamp-tools tw-flex tw-items-center tw-gap-2 tw-text-black dark:tw-text-white">
        <button id="zoomStamp" class="stamp-tool" aria-pressed="false" title="Zoom: magnify the stamps under the pointer">
            <svg class='tw-fill-black dark:tw-fill-white' xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
              <path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Zm-40-60v-80h-80v-80h80v-80h80v80h80v80h-80v80h-80Z"/>
            </svg>
        </button>
        <button id="crossHairStamps" class="stamp-tool" aria-pressed="true" title="Crosshair: mark the alert position">
            <svg class='tw-fill-black dark:tw-fill-white' xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3">
              <path d="M480-320q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47Zm0-80q33 0 56.5-23.5T560-480q0-33-23.5-56.5T480-560q-33 0-56.5 23.5T400-480q0 33 23.5 56.5T480-400Zm0-80ZM200-120q-33 0-56.5-23.5T120-200v-160h80v160h160v80H200Zm400 0v-80h160v-160h80v160q0 33-23.5 56.5T760-120H600ZM120-600v-160q0-33 23.5-56.5T200-840h160v80H200v160h-80Zm640 0v-160H600v-80h160q33 0 56.5 23.5T840-760v160h-80Z"/>
            </svg>
        </button>
        {% if survey_id == "lsst" %}
        {# Rubin's mount turns the field between visits; this re-renders the stamps rotated to North up / East left #}
        <button id="northUpStamps"
          class="stamp-tool"
          data-measurement-id="{{ selected_measurement_id }}"
          data-north-up="{{ 'false' if north_up else 'true' }}"
          aria-pressed="{{ 'true' if north_up else 'false' }}"
          title="{{ 'North up, East left. Click to show the stamps as taken' if north_up else 'Stamps as taken. Click to rotate them to North up, East left' }}"
          hx-post="{{ API_URL }}/htmx/update_stamp_card"
          hx-trigger="click"
          hx-target="#stamp-app"
          hx-swap="innerHTML"
          hx-vals="js:{payload: stampPayload('northUpStamps')}">
          N↑
        </button>
        {% endif %}
    </div>
</div>

<div class="tw-w-[95%] tw-mx-auto tw-flex tw-flex-col tw-items-center">
  {% if has_stamp_selected_measurement_id and stamps_available %}
    {% include "stamps_images.html.jinja" %}
    <div class="tw-justify-center"> measurement id: {{ selected_measurement_id }} </div>
  {% elif has_stamp_selected_measurement_id %}
    <div class="tw-h-full tw-flex tw-items-center tw-justify-center">
      <div class="tw-bg-yellow-50 dark:tw-bg-yellow-900 tw-border tw-border-yellow-200 dark:tw-border-yellow-700 tw-rounded-md tw-p-4 tw-mb-4">
          <strong class="tw-text-yellow-800 dark:tw-text-yellow-200">Info:</strong>
          <span id="stamps-unavailable" class="tw-text-yellow-700 dark:tw-text-yellow-300">The stamps for measurement id (candid) {{ selected_measurement_id }} are temporarily unavailable.</span>
      </div>
    </div>
  {% else %}
    <div class="tw-h-full tw-flex tw-items-center tw-justify-center">
      <div class="tw-bg-yellow-50 dark:tw-bg-yellow-900 tw-border tw-border-yellow-200 dark:tw-border-yellow-700 tw-rounded-md tw-p-4 tw-mb-4">
          <strong class="tw-text-yellow-800 dark:tw-text-yellow-200">Info:</strong> 
          <span class="tw-text-yellow-700 dark:tw-text-yellow-300">No stamps for this measurement id (candid): {{ selected_measurement_id }}.</span>
      </div>
    </div>
  {% endif%}
</div>

<script type="module">
  import {init, downloadStamp} from "{{ ASSETS_URL }}/static/stamp.js"

  init()
</script>
