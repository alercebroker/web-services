<meta name="htmx-config" content='{"selfRequestsOnly": false}'>
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="{{ ASSETS_URL }}/htmx/htmx.min.js"></script>
<script src="https://unpkg.com/htmx-ext-response-targets@2.0.2" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>
<link rel="stylesheet" href="{{ ASSETS_URL }}/static/object.css">

<div id="form-search" hx-ext="response-targets" class="tw-preflight tw-text-black tw-bg-white dark:tw-bg-[#1e1e1e] dark:tw-text-[#EEEEEE]">
    {% from "input.html.jinja" import input as customInput %}
    {% from "search_form/dropdown.html.jinja" import dropdown %}
    {% from "search_form/mjd_date_input.html.jinja" import mjd_date_input %}
    {% from "search_form/help_tip.html.jinja" import help_tip %}

    <div class="tw-flex tw-w-full">
        <div id="form-container" class="tw-p-4 tw-flex tw-flex-col tw-gap-y-4 tw-w-full tw-shadow-md dark:tw-border dark:tw-border-black lg:tw-max-w-[458px]">

            <!--Search filters-->

            <div id="search_filters" class="tw-w-full tw-font-medium tw-text-xl">Search Filters</div>

            <!--Survey filters-->
            <div id="survey_container" class="obj-form-section tw-w-full">
                <div class="tw-flex tw-items-center tw-gap-2">
                    <p class="tw-font-medium tw-text-lg">Surveys</p>

                    {% call help_tip() %}
                        LSST: Vera C. Rubin Observatory. ZTF: Zwicky Transient Facility.
                        <br>
                        Each survey has its own objects and classifiers.
                    {% endcall %}
                </div>

                <div id="survey" data-survey="{{survey}}" class="tw-w-full tw-mt-4 tw-flex tw-justify-start tw-gap-4">
                    <span id="lsst_btn" class="{{'obj-survey-selected' if survey == 'lsst' else 'obj-survey-unselect'}} tw-w-1/4 hover:tw-bg-[#b2b2b2] hover:tw-cursor-pointer">LSST</span>
                    <span id="ztf_btn" class="{{'obj-survey-selected' if survey == 'ztf' else 'obj-survey-unselect'}} tw-w-1/4 hover:tw-bg-[#b2b2b2] hover:tw-cursor-pointer">ZTF</span>
                </div>
            </div>

            <!--Object ID: a search by itself-->
            <div id="object_id_container" class="obj-form-section tw-w-full">
                <div class="tw-flex tw-items-center tw-gap-2">
                    <p class="tw-font-medium tw-text-lg">Object IDs</p>

                    {% call help_tip() %}
                        Type or paste up to 200 IDs, separated by spaces, commas or line breaks.
                        <br>
                        Press Enter to add them.
                    {% endcall %}
                </div>

                <div class="tw-mt-4 tw-grid tw-grid-cols-12 tw-gap-4">
                    <div class="tw-col-span-12 tw-flex tw-flex-col tw-content-center">
                        <div id="oids_container" data-oids_list="[]" class="tw-hidden tw-pb-2 tw-flex tw-gap-2 tw-flex-wrap">
                            <button type="button" id="clear_oids_btn" class="tw-justify-items-end tw-w-full">
                                <svg class="tw-h-[24px] tw-w-[24px] tw-fill-[#1565C0]" viewBox="0 -960 960 960"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
                            </button>
                        </div>

                        {{customInput(id="objectIds", type="text", placeholder="One or more object IDs")}}
                    </div>
                </div>
            </div>

            <!--Object properties filters-->
            <div class="obj-form-section tw-w-full">
                <div id="object_filters" class="tw-text-[#1976d2] tw-h-[40px] tw-flex tw-items-center tw-justify-between tw-font-medium tw-text-lg hover:tw-bg-[#1976d2]/20 hover:tw-cursor-pointer">
                    <p>Object Properties</p>
                    <svg name="arrow_icon" data-direction="up" class="tw-w-[24px] tw-h-[24px] tw-fill-[#1976d2] dark:tw-fill-[#1976d2]" viewBox="0 -960 960 960"><path d="M480-528 296-344l-56-56 240-240 240 240-56 56-184-184Z"/></svg>
                </div>

                <div id="object_filters_container" class="tw-mx-auto tw-mt-4 tw-grid tw-grid-cols-12 tw-gap-4">
                    <div id="detections range" class="tw-col-span-12 tw-w-full">
                        <div class="tw-flex tw-items-center tw-gap-2">
                            <p class="tw-font-medium">Number of detections range</p>

                            {% call help_tip() %}
                                How many times the survey detected the object.
                            {% endcall %}
                        </div>
                        <div id="detections_container" class="tw-flex tw-justify-between">
                            {{customInput(id="min_detections", type="number", placeholder="Min", width="tw-w-1/3")}}

                            {{customInput(id="max_detections", type="number", placeholder="Max", width="tw-w-1/3")}}

                        </div>
                    </div>

                    <!--Discovery date filters-->
                    <div class="tw-col-span-12 tw-w-full">
                        <div id="discovery_date_filters" class="tw-h-[40px] tw-flex tw-items-center tw-justify-between tw-font-medium hover:tw-bg-[#b2b2b2] hover:tw-cursor-pointer">
                            <div class="tw-flex tw-items-center tw-gap-2">
                                <p>Discovery date</p>

                                {% call help_tip() %}
                                    The date of the object's first detection.
                                    <br>
                                    Type an MJD or a UTC date (dd/mm/yyyy hh:mm), or pick one in the calendar.
                                {% endcall %}
                            </div>
                            <svg name="arrow_icon" data-direction="down" class="tw-w-[24px] tw-h-[24px] tw-fill-dark dark:tw-fill-white" viewBox="0 -960 960 960"><path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/></svg>
                        </div>

                        <div id="discovery_date_filters_container" class="tw-hidden tw-mx-auto tw-my-4 tw-grid tw-grid-cols-12 tw-gap-4">
                            {{mjd_date_input("min_mjd", "Min")}}

                            {{mjd_date_input("max_mjd", "Max")}}
                        </div>
                    </div>

                    <!--Last detection date filters: object.lastmjd-->
                    <div class="tw-col-span-12 tw-w-full">
                        <div id="last_alert_date_filters" class="tw-h-[40px] tw-flex tw-items-center tw-justify-between tw-font-medium hover:tw-bg-[#b2b2b2] hover:tw-cursor-pointer">
                            <div class="tw-flex tw-items-center tw-gap-2">
                                <p>Last detection date</p>

                                {% call help_tip() %}
                                    The date of the object's latest detection.
                                    <br>
                                    A recent date finds objects that are still active.
                                {% endcall %}
                            </div>
                            <svg name="arrow_icon" data-direction="down" class="tw-w-[24px] tw-h-[24px] tw-fill-dark dark:tw-fill-white" viewBox="0 -960 960 960"><path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/></svg>
                        </div>

                        <div id="last_alert_date_filters_container" class="tw-hidden tw-mx-auto tw-my-4 tw-grid tw-grid-cols-12 tw-gap-4">
                            {{mjd_date_input("min_lastmjd", "Min")}}

                            {{mjd_date_input("max_lastmjd", "Max")}}
                        </div>
                    </div>

                    <!--Conesearch filters-->
                    <div class="tw-col-span-12 tw-w-full">

                        <div id="conesearch_filters" class="tw-h-[40px] tw-flex tw-items-center tw-justify-between hover:tw-bg-[#b2b2b2] hover:tw-cursor-pointer">

                            <div class="tw-flex tw-items-center tw-gap-2">
    
                                <span class="tw-font-medium">Conesearch</span>

                                {% call help_tip() %}
                                    Conesearch is a coordinate search tool with a search radius.
                                    <br>
                                    You can input RA/Dec manually or, optionally, give a target name and let Sesame fill in the coordinates.
                                    <br>
                                    Formats accepted for HMS/DMS: "23:14:56.3" or "23 14 56.3".
                                {% endcall %}
                            </div>

                            <svg name="arrow_icon" data-direction="down" class="tw-w-[24px] tw-h-[24px] tw-fill-dark dark:tw-fill-white" viewBox="0 -960 960 960"><path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/></svg>
                        </div>


                        <div id="conesearch_filters_container" class="tw-hidden tw-container tw-grid tw-grid-cols-12 tw-my-4 tw-gap-4">
                    
                            <div class="tw-col-span-12 lg:tw-col-span-5 sm:tw-col-span-11">
                                {{customInput(id="target_name", type="text", width="tw-w-full", placeholder="Target Name")}}
                            </div>

                            <div class="tw-px-4 tw-flex tw-flex-col tw-items-end tw-col-span-12 lg:tw-col-span-7 sm:tw-col-span-12">
                                <button id="resolve_btn" class="tw-w-[95%] tw-h-[36px] tw-shadow-xl tw-border tw-border-gray-300 dark:tw-border-gray-600 tw-bg-white dark:tw-bg-[#424242] tw-text-[#1976D2] dark:tw-text-[#F5F5F5] tw-font-medium tw-rounded">RESOLVE</button>
                                <label class="tw-text-sm tw-mt-1">Provided by <a href="https://vizier.cds.unistra.fr/vizier/doc/sesame.htx" target="_blank" class="tw-text-[#1976d2]">sesame</a></label>
                            </div>

                            <div class="tw-col-span-12 lg:tw-col-span-12 sm:tw-col-span-12">
                                <input type="radio" id="degrees" name="consearch_radio" value="degrees" checked>
                                <label>Degrees</label>

                                <input type="radio" id="HMS/DMS" name="consearch_radio" value="HMS/DMS">
                                <label>HMS/DMS</label>
                            </div>

                            {{customInput(id="ra_consearch", type="number", width="tw-col-span-12 lg:tw-col-span-6 sm:tw-col-span-12", placeholder="RA (deg)", step="1")}}

                            {{customInput(id="dec_consearch", type="number", width="tw-col-span-12 lg:tw-col-span-6 sm:tw-col-span-12", placeholder="Dec (deg)", step="1")}}

                            {{customInput(id="radius_consearch", type="number", width="tw-col-span-12", placeholder="Radius (arcsec)", step="0.00001")}}

                        </div>
                    </div>
                </div>
            </div>

            <!--Classification filters: they work well together-->
            <div class="obj-form-section tw-w-full">
                <div id="classification_filters" class="tw-text-[#1976d2] tw-h-[40px] tw-flex tw-items-center tw-justify-between tw-font-medium tw-text-lg hover:tw-bg-[#1976d2]/20 hover:tw-cursor-pointer">
                    <div class="tw-flex tw-items-center tw-gap-2">
                        <p>Classification</p>

                        {% call help_tip() %}
                            Classifier: the ALeRCE model whose predictions you search.
                            <br>
                            Stamp classifiers use the images of the first detection; light curve classifiers use the light curve.
                            <br>
                            Class: the class that classifier finds most likely for the object.
                        {% endcall %}
                    </div>
                    <svg name="arrow_icon" data-direction="up" class="tw-w-[24px] tw-h-[24px] tw-fill-[#1976d2] dark:tw-fill-[#1976d2]" viewBox="0 -960 960 960"><path d="M480-528 296-344l-56-56 240-240 240 240-56 56-184-184Z"/></svg>
                </div>

                <div id="classification_filters_container" class="tw-mx-auto tw-mt-4 tw-grid tw-grid-cols-12 tw-gap-4">
                    <!--select classifiers-->
                    <div id="classifiers_wrapper" class="tw-col-span-12 lg:tw-col-span-6">
                        {{dropdown(
                            placeholder="Classifier", selected_id="classifiers_selected", options_id="classifiers_options",
                            classifier_container_id="classifier_container"
                        )}}
                    </div>

                    <!--select classes-->
                    <div class="obj-select-wrapper tw-col-span-12 lg:tw-col-span-6 md:tw-col-span-12 sm:tw-col-span-12">
                        {{dropdown(
                            placeholder="Class",
                            selected_id="class_selected", options_id="classes_options",
                            classifier_container_id="class_container"
                        )}}
                    </div>
                    
                    <div id="probability_container" class="tw-col-span-12 tw-flex tw-items-center tw-gap-2">
                        <label class="tw-font-medium tw-whitespace-nowrap">Probability ≥</label>

                        {% call help_tip() %}
                            Keeps the objects whose most likely class has at least this probability.
                            <br>
                            At 0 it keeps them all.
                        {% endcall %}

                        <label id="prob_number" class="tw-inline-block tw-w-[36px]"> 0.00</label>
                        <input id="prob_range" class="" type="range" step="0.01" max="1" value="0.00">
                    </div>

                    <!--probability.lastmjd-->
                    <div class="tw-col-span-12 tw-w-full">
                        <div id="classifier_date_filters" class="tw-h-[40px] tw-flex tw-items-center tw-justify-between tw-font-medium hover:tw-bg-[#b2b2b2] hover:tw-cursor-pointer">
                            <div class="tw-flex tw-items-center tw-gap-2">
                                <p>Last detection used by the classifier</p>

                                {% call help_tip() %}
                                    The date of the latest detection the selected classifier used for its prediction.
                                    <br>
                                    Light curve classifiers use most of an object's detections (quality filters discard some), so it is usually the last detection.
                                    <br>
                                    Stamp classifiers use only the first one, so it is usually the discovery date.
                                    <br>
                                    It is not when the classification was made: a new classifier run today on a 2018 object gives a 2018 date.
                                    <br>
                                    Combined with a class, this filter is much faster than the Discovery Date.
                                {% endcall %}
                            </div>

                            <svg name="arrow_icon" data-direction="down" class="tw-w-[24px] tw-h-[24px] tw-fill-dark dark:tw-fill-white" viewBox="0 -960 960 960"><path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/></svg>
                        </div>

                        <div id="classifier_date_filters_container" class="tw-hidden tw-mx-auto tw-my-4 tw-grid tw-grid-cols-12 tw-gap-4">
                            {{mjd_date_input("min_prob_lastmjd", "Min")}}

                            {{mjd_date_input("max_prob_lastmjd", "Max")}}
                        </div>
                    </div>
                </div>
            </div>

            <!--Buttons-->
            <div class="tw-w-full tw-flex tw-justify-start tw-gap-4 tw-flex-col lg:tw-flex-row">
                <button 
                id="search_btn"
                hx-get="{{API_URL}}/htmx/list_objects"
                hx-trigger="click"
                hx-swap="outerHTML"
                hx-target="#objects_table"
                hx-indicator="#table-objects-loading"
                hx-disabled-elt="this"
                hx-vals='js:{...send_form_Data(), ...send_pagination_data()}'
                class="tw-bg-[#1565C0] tw-text-blue-50 tw-rounded tw-w-full lg:tw-w-1/2 sm:tw-w-full tw-h-[40px]">
                    <!--While the search runs, htmx disables the button and "Searching…" takes the label's place.
                        Not through hx-indicator: htmx 2.0.2 never removes its class from an element that is
                        also its hx-disabled-elt.-->
                    <span class="obj-search-label">SEARCH</span>
                    <span class="obj-searching-label tw-items-center tw-justify-center tw-gap-2">
                        <svg class="tw-animate-spin tw-w-[20px] tw-h-[20px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" stroke-opacity="0.25"/>
                            <path d="M21 12a9 9 0 0 0-9-9" stroke-linecap="round"/>
                        </svg>
                        SEARCHING…
                    </span>
                </button>

                <!--Keeps the survey: a cleared form searches the same one.-->
                <button
                id="clear_form"
                class=" tw-text-black/80 dark:tw-text-[#F5F5F5] tw-rounded tw-w-full tw-bg-[#f5f5f5] dark:tw-bg-[#424242] lg:tw-w-1/4 sm:tw-w-full"
                hx-get="{{API_URL}}/htmx/search_objects/"
                hx-vals='js:{survey_id: document.getElementById("survey").dataset.survey}'
                hx-trigger="click"
                hx-swap="outerHTML"
                hx-target="#form-search"
                >CLEAR</button>
            </div>
        </div>
    </div>

</div>

<script type="module">
import {init, elementReady} from "{{ ASSETS_URL }}/static/search_form/form_search.js"


elementReady("#form-search").then((el) => {
  init();
});
</script>

<script id="form-data" type="application/json">
{
    "classifiers": {{classifiers | tojson}}
}
</script>
