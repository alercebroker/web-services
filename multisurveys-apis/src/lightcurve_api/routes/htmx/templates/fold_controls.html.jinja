{% import 'toggle.html.jinja' as ui %}
{#
  Period controls. The ‹ › and « » buttons (and the arrow keys in the period box, Shift for the larger step)
  change the period by a step sized to the light curve's time span, so each click slides the fold the same
  fraction of a cycle at any period: see lightcurve-app.js, nudgePeriod.
#}
<div class="lc-row">
  {{ ui.label("Fold", "The period folded light curve, where time is transformed to time modulo the period (phase). Period is computed automatically when you enable Fold.") }}
  <div class="lc-ctl" style="flex-wrap:nowrap">
    {{ ui.switch("fold", config.fold) }}
    <input name="period" value="{{config.period}}" class="lc-input" style="width:96px;margin-left:auto" aria-label="Period (days)" data-tip="Period, in days. The up and down arrow keys change it a little, with Shift a little more.">
  </div>
</div>
<div class="lc-row">
  <span class="lc-label"></span>
  <div class="lc-ctl lc-period-steps">
    <button type="button" class="lc-btn lc-btn-outline" data-period-step="-0.1" data-tip="Shorter period: the fold slides a tenth of a cycle across the light curve">«</button>
    <button type="button" class="lc-btn lc-btn-outline" data-period-step="-0.02" data-tip="Slightly shorter period: the fold slides 2% of a cycle across the light curve">‹</button>
    <button type="button" class="lc-btn lc-btn-outline" data-period-step="0.02" data-tip="Slightly longer period: the fold slides 2% of a cycle across the light curve">›</button>
    <button type="button" class="lc-btn lc-btn-outline" data-period-step="0.1" data-tip="Longer period: the fold slides a tenth of a cycle across the light curve">»</button>
    <button type="button" class="lc-btn lc-btn-outline" data-period-factor="2" data-tip="Double the period" style="margin-left:auto">×2</button>
    <button type="button" class="lc-btn lc-btn-outline" data-period-factor="0.5" data-tip="Halve the period">/2</button>
  </div>
</div>
<div class="lc-row">
  <span class="lc-label"></span>
  <div class="lc-ctl">
    {{ ui.switch("periodogram_enabled", config.periodogram_enabled, not config.fold, "Periodogram", "Show the light curve periodogram. Click a point on it to fold at that period.") }}
  </div>
</div>
