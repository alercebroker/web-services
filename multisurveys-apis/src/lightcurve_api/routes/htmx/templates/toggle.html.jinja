{#
  Controls of the side panel, styled by static/lightcurve-panel.css. Help texts go in data-tip:
  lightcurve-app.js shows them in a floating tooltip. A control locked by the script (setToggleLocked)
  shows its reason the same way.
#}

{# Row label, uppercase, with an optional help text #}
{% macro label(text, tip="") -%}
<span class="lc-label"{% if tip %} data-tip="{{ tip }}" tabindex="0"{% endif %}>{{ text }}</span>
{%- endmacro %}

{# On/off switch #}
{% macro switch(name, checked=False, disable=False, text="", tip="") -%}
<label class="lc-switch"{% if tip %} data-tip="{{ tip }}"{% endif %}>
  <input type="checkbox" name="{{ name }}" class="lc-sr" {% if checked %}checked{% endif %} {% if disable %}disabled{% endif %}>
  <span class="lc-switch-track" aria-hidden="true"></span>
  {% if text %}<span class="lc-switch-text">{{ text }}</span>{% endif %}
</label>
{%- endmacro %}

{#
  Two-way choice over one checkbox (unchecked = left, checked = right). Each button sets its side
  (lightcurve-app.js, bindSegmented), so clicking the side already chosen keeps it.
#}
{% macro segmented(name, off, on, checked=False, tip="") -%}
<label class="lc-seg"{% if tip %} data-tip="{{ tip }}"{% endif %}>
  <input type="checkbox" name="{{ name }}" class="lc-sr" tabindex="-1" {% if checked %}checked{% endif %}>
  <button type="button" class="lc-seg-off" data-seg="off">{{ off }}</button><button type="button" class="lc-seg-on" data-seg="on">{{ on }}</button>
</label>
{%- endmacro %}
