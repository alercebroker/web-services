{#
  Bands and data types. The chips double as the chart's legend: each band chip takes the color of its
  series (set by lightcurve-app.js from its COLORS table), and each type chip shows the markers it is
  drawn with (SYMBOLS in lightcurve-app.js).
#}
{% import 'toggle.html.jinja' as ui %}

{% macro band_chip(name, survey, band, checked) -%}
<label class="lc-chip lc-band" data-survey="{{ survey }}" data-band="{{ band }}">
  <input type="checkbox" name="{{ name }}" value="{{ band }}" class="lc-sr" {% if checked %}checked{% endif %}>
  <span>{{ band }}</span>
</label>
{%- endmacro %}

{% macro marker(shape, title) -%}
<svg class="lc-marker" viewBox="0 0 10 10" role="img" aria-label="{{ title }}"><title>{{ title }}</title>
  {%- if shape == 'circle' %}<circle cx="5" cy="5" r="4.5" fill="currentColor"/>
  {%- elif shape == 'roundRect' %}<rect x="0.5" y="0.5" width="9" height="9" rx="2.5" fill="currentColor"/>
  {%- elif shape == 'square' %}<rect x="0.5" y="0.5" width="9" height="9" fill="currentColor"/>
  {%- elif shape == 'diamond' %}<path d="M5 0 L10 5 L5 10 L0 5 Z" fill="currentColor"/>
  {%- elif shape == 'triangle' %}<path d="M0 1 H10 L5 10 Z" fill="currentColor"/>
  {%- endif %}</svg>
{%- endmacro %}

{% macro type_chip(value, text, checked, markers) -%}
<label class="lc-chip lc-type">
  <input type="checkbox" name="data_types[]" value="{{ value }}" class="lc-sr" {% if checked %}checked{% endif %}>
  <span>{% for shape, title in markers %}{{ marker(shape, title) }}{% endfor %}{{ text }}</span>
</label>
{%- endmacro %}

<div class="lc-row">
  {{ ui.label("ZTF", "ZTF bands. Each chip has the color of its points.") }}
  <div class="lc-ctl">
    {% for b in ['g','r','i'] %}{{ band_chip("bands.ztf[]", "ztf", b, b in config.bands.ztf) }}{% endfor %}
  </div>
</div>

<div class="lc-row">
  {{ ui.label("LSST", "LSST bands. Each chip has the color of its points.") }}
  <div class="lc-ctl">
    {% for b in ['u','g','r','i','z','y'] %}{{ band_chip("bands.lsst[]", "lsst", b, b in config.bands.lsst) }}{% endfor %}
  </div>
</div>

<!-- ZTF DR bands (shown only when external sources are on) -->
<div class="lc-row ztf-dr-bands-row {% if not config.external_sources.enabled %}tw-hidden{% endif %}">
  {{ ui.label("ZTF DR", "ZTF Data Release bands.") }}
  <div class="lc-ctl">
    {% for b in ['g','r','i'] %}{{ band_chip("bands.ztf_dr[]", "ztf dr", b, b in config.bands.ztf_dr) }}{% endfor %}
  </div>
</div>

<div class="lc-row">
  {{ ui.label("Type", "Detections, limiting magnitudes and forced photometry. Markers: ZTF detections are circles and LSST ones rounded squares; forced photometry is a square for ZTF and a diamond for LSST; limiting magnitudes are triangles.") }}
  <div class="lc-ctl">
    {{ type_chip("detections", "det", 'detections' in config.data_types, [("circle", "ZTF"), ("roundRect", "LSST")]) }}
    {{ type_chip("non_detections", "lim. mag", 'non_detections' in config.data_types, [("triangle", "ZTF")]) }}
    {{ type_chip("forced_photometry", "f. phot", 'forced_photometry' in config.data_types, [("square", "ZTF"), ("diamond", "LSST")]) }}
  </div>
</div>
