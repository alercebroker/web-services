{% import 'toggle.html.jinja' as ui %}

<!--
  Config form – all changes are handled client-side by lightcurve-app.js.
  No server POST on change; the form has no action/method.
-->
<form id="config-form" autocomplete="off">

  {% if group %}{% include "group_panel.html.jinja" %}{% endif %}

  <div class="lc-section">
    {% include "band_toggles.html.jinja" %}
  </div>

  <div class="lc-section">
    <div class="lc-row">
      {{ ui.label("View", "Magnitude or flux; difference or total (science) magnitude.") }}
      <div class="lc-ctl">
        {{ ui.segmented("flux", "Mag", "Flux", config.flux) }}
        {{ ui.segmented("total", "Diff", "Total", config.total) }}
        <!-- Shown by JS in Total when some points have no total magnitude and are left out -->
        <span id="total-hidden-hint" class="lc-hint tw-hidden" tabindex="0">!</span>
      </div>
    </div>

    <div class="lc-row">
      {{ ui.label("External", "Show light curves from available external sets: ZTF Data Release 24.") }}
      <div class="lc-ctl">
        {{ ui.switch("external_sources.enabled", config.external_sources.enabled) }}
        <button
          type="button"
          class="lc-btn lc-btn-outline lc-btn-icon"
          aria-label="Filter external sources"
          data-tip="Choose which ZTF Data Release objects to show"
          hx-get="{{ API_URL }}/htmx/external_sources"
          hx-target="#dr-picker-container"
          hx-swap="innerHTML"
          hx-on::after-request="document.getElementById('dr-picker-container').classList.remove('tw-hidden')"
          hx-vals='{"oid": "{{ config.oid }}", "survey_id": "{{ config.survey_id }}", "meanra": {{ config.meanra }}, "meandec": {{ config.meandec }}}'
        >
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.707A1 1 0 013 7V4z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="lc-section">
    {% include "fold_controls.html.jinja" %}
  </div>

  <div class="lc-section">
    <div class="lc-row">
      {{ ui.label("Offset", "Shift the bands apart by a magnitude or flux step, ordered by the chosen statistic.") }}
      <div class="lc-ctl lc-ctl-nowrap">
        {{ ui.switch("offset_bands", config.offset_bands) }}
        <input name="offset_num" type="range" min="1" max="10" value="{{ config.offset_num }}" class="lc-range" aria-label="Offset step">
        <select name="offset_metric" class="lc-input" aria-label="Offset statistic">
          <option value="avg"    {% if config.offset_metric == "avg"    %}selected{% endif %}>avg</option>
          <option value="min"    {% if config.offset_metric == "min"    %}selected{% endif %}>min</option>
          <option value="max"    {% if config.offset_metric == "max"    %}selected{% endif %}>max</option>
          <option value="median" {% if config.offset_metric == "median" %}selected{% endif %}>median</option>
        </select>
      </div>
    </div>
  </div>

  <div class="lc-section">
    <a href="{{ API_URL }}/htmx/download?oid={{ config.oid }}&survey_id={{ config.survey_id }}" class="lc-btn lc-btn-block" download>
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      Download
    </a>
  </div>

</form>
