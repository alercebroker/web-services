{#
  Object group (association): the objects that are the same source as this one, and nearby objects that
  scored below the threshold. lightcurve-app.js fetches each checked object's photometry on demand and draws
  it hollow in the series of its survey and band. Values are "survey:oid" (see group_service.GroupObject.key).
  Kept compact for the side panel: one line per object with the distance in its tooltip, a scroll past about
  8 members, the section folded when the object is alone, and the nearby objects always folded.
#}
{% macro object_row(obj, checked) %}
<label class="lc-obj"
       data-tip="{{ obj.survey_id | upper }} {{ obj.oid }}{% if obj.is_self %}: this object{% elif obj.score is not none %}. Score {{ '%.3f' | format(obj.score) }} at {{ '%.2f' | format(obj.dist) }}″{% if obj.linked_via %}, linked through {{ obj.linked_via }}{% endif %}{% endif %}">
  {% if obj.is_self %}
  <input type="checkbox" checked disabled>
  {% else %}
  <input type="checkbox" name="group.objects[]" value="{{ obj.key }}" {% if checked %}checked{% endif %}>
  {% endif %}
  <span class="lc-obj-survey" style="color:{{ '#C0610E' if obj.survey_id == 'ztf' else '#0B827E' }}">{{ obj.survey_id | upper }}</span>
  <span class="lc-obj-id">{{ obj.oid }}</span>
  <span class="lc-obj-score">
    {%- if obj.is_self %}this{% elif obj.score is not none %}{{ '%.2f' | format(obj.score) }}{% if obj.linked_via %} ↗{% endif %}{% endif -%}
  </span>
</label>
{% endmacro %}

{% set others = group.members | length - 1 %}
<details id="group-panel" class="lc-section" {% if others > 0 %}open{% endif %}>
  <summary>
    <span class="lc-title" data-tip="Objects the association links to this one, with the score of each pair. Others are drawn hollow, in total magnitude.{% if group.group_id is not none %} Group {{ group.group_id }}, version {{ group.group_version }}.{% endif %}">Same source</span>
    <span class="lc-muted">{{ others + 1 }} object{{ 's' if others else '' }}</span>
    <span id="group-status" class="lc-muted lc-pulse tw-hidden">loading…</span>
  </summary>

  <div class="lc-objects">
    {% for obj in group.members %}{{ object_row(obj, True) }}{% endfor %}
    {% if not others %}
    <span class="lc-muted">No other object scored {{ group.threshold }} or more.</span>
    {% endif %}
  </div>

  {% if group.nearby %}
  <details>
    <summary><span class="lc-muted">Nearby, not in the group ({{ group.nearby | length }})</span></summary>
    {% for obj in group.nearby %}{{ object_row(obj, False) }}{% endfor %}
  </details>
  {% endif %}
</details>
