<script src="{{ ASSETS_URL }}/htmx/htmx.min.js"></script>
<meta name="htmx-config" content='{"selfRequestsOnly": false}'>
<link rel="stylesheet" href="{{ ASSETS_URL }}/static/status.css">

{# Each request (the minute refresh, a window button, refresh) swaps only this div: hx-select picks it out of
   the answer, so the script and stylesheet above aren't added again. On an error htmx keeps the last card. #}
{% set scenario_qs = ("&scenario=" ~ scenario) if scenario else "" %}
{% set card_url = API_URL ~ "/htmx/pipeline_status?window=" ~ window ~ scenario_qs %}
{% set dot_colors = {"up_to_date": "#00e676", "processing": "#ffc107", "no_data": "#9e9e9e", "unknown": "#616161"} %}
<div id="pipeline-status-app"
     class="tw-preflight tw-p-4 tw-text-sm tw-text-[#1e1e1e] dark:tw-text-white tw-bg-white dark:tw-bg-bgdark tw-rounded-[6px] tw-font-roboto"
     hx-get="{{ card_url }}" hx-trigger="every 60s" hx-select="#pipeline-status-app" hx-swap="outerHTML">

    <div class="tw-flex tw-items-center tw-mb-2">
        <span class="tw-text-base tw-font-medium">Pipeline status</span>
        <button class="tw-ml-auto tw-px-2 tw-py-1 tw-rounded hover:tw-bg-gray-200 dark:hover:tw-bg-gray-700"
                title="Refresh" aria-label="Refresh pipeline status"
                hx-get="{{ card_url }}" hx-target="#pipeline-status-app" hx-select="#pipeline-status-app" hx-swap="outerHTML">&#x21bb;</button>
    </div>

    {% if unavailable %}
    <div class="tw-text-xs tw-text-gray-600 dark:tw-text-gray-400" id="pipeline-status-unavailable">
        The pipeline status is temporarily unavailable. This card tries again every minute.
    </div>
    {% else %}
    {% for p in pipelines %}
    <div class="tw-flex tw-mb-2" id="pipeline-{{ p.survey }}">
        <span class="tw-inline-block tw-w-3 tw-h-3 tw-rounded-full tw-shrink-0 tw-mr-3 tw-mt-1" style="background: {{ dot_colors[p.status] }}"></span>
        <div>
            <div><strong>{{ p.name }}</strong> · {{ p.status_label }}</div>
            <div class="tw-text-xs tw-text-gray-600 dark:tw-text-gray-400">
                {{ p.message }}{% if p.last_alert %} Last alert received at {{ p.last_alert }}.{% endif %}
            </div>
        </div>
    </div>
    {% endfor %}

    <div class="tw-flex tw-items-center tw-flex-wrap tw-gap-1 tw-mt-3">
        <span class="tw-text-xs tw-mr-1">Alerts received in the last</span>
        {% for w in windows %}
        <button class="tw-px-2 tw-py-0.5 tw-text-xs tw-rounded tw-border tw-border-gray-300 dark:tw-border-gray-600
                       {% if w.name == window %}tw-bg-gray-800 tw-text-white dark:tw-bg-gray-200 dark:tw-text-[#1e1e1e]{% endif %}
                       disabled:tw-opacity-40 disabled:tw-cursor-not-allowed"
                {% if w.availability == "beyond_history" %}disabled title="Longer than the metrics history"
                {% elif w.availability == "unavailable" %}title="Alert counts are temporarily unavailable"{% endif %}
                hx-get="{{ API_URL }}/htmx/pipeline_status?window={{ w.name }}{{ scenario_qs }}"
                hx-target="#pipeline-status-app" hx-select="#pipeline-status-app" hx-swap="outerHTML">{{ w.name }}</button>
        {% endfor %}
    </div>

    {% if counts_unavailable %}
    <div class="tw-text-xs tw-text-gray-600 dark:tw-text-gray-400 tw-mt-3" id="pipeline-status-counts-unavailable">
        The alert counts for the last {{ window }} are temporarily unavailable.
    </div>
    {% endif %}
    <div class="tw-flex tw-mt-3 tw-text-center">
        {% for p in pipelines %}
        <div class="tw-flex-1">
            <div class="tw-text-xs">{{ p.name }}</div>
            <div class="tw-text-xl tw-font-medium">{{ p.received }}</div>
            <div class="tw-text-xs tw-text-gray-600 dark:tw-text-gray-400">{{ p.processed }} processed</div>
        </div>
        {% endfor %}
    </div>

    <div class="tw-text-xs tw-text-gray-600 dark:tw-text-gray-400 tw-mt-4">
        Alerts take a few minutes to become searchable after they are processed.
        Windows longer than the metrics history are disabled. Updated {{ updated }}.
        {% if simulated %}<strong>Simulated data.</strong>{% endif %}
    </div>
    {% endif %}
</div>
